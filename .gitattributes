# Shell scripts and source fixtures use the same line endings on every platform.
* text=auto eol=lf
*.bin binary
# Recorded vendor and archive responses are kept byte for byte.
crates/pe-trackers/tests/fixtures/** -text
crates/pe-env/tests/fixtures/** -text
# Polar file fixtures test CRLF, BOMs and UTF-16, and the golden files pin
# export bytes (invariant 5): both byte for byte.
crates/pe-polar/tests/fixtures/** -text
crates/pe-polar/tests/golden/** -text
# Real-world sample polars (M9b, user request): kept exactly as the boats'
# owners wrote them, CRLF and all, not normalised to LF.
polar_examples/** -text
# The GRIB golden export (invariant 5): byte for byte.
*.grib2 binary
crates/pe-grib/tests/golden/** -text
